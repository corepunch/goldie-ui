<scene>
  <camera pos="0 1.6 4.5" look="0 1.0 -3" fov="65"/>
  <ambient color="0.10 0.10 0.13"/>
  <background color="0.04 0.05 0.07"/>

  <!-- one shadow-casting point light (a "ceiling lamp") -->
  <light type="point" pos="0.5 2.5 -1.5" color="1.0 0.95 0.85" intensity="1.3" castShadows="1"/>

  <material id="wall"   color="0.80 0.78 0.72" shininess="6"/>
  <material id="floor"  color="0.35 0.28 0.22" shininess="12"/>
  <material id="wood"   color="0.50 0.32 0.18" shininess="20"/>
  <material id="fabric" color="0.55 0.15 0.18" shininess="4"/>
  <material id="metal"  color="0.70 0.70 0.75" shininess="60"/>
  <material id="glass"  color="0.65 0.80 0.85" shininess="90"/>

  <!-- floor -->
  <box pos="0 -0.05 -3" size="8 0.1 6" material="floor" castShadow="0"/>

  <!-- back wall with a door opening -->
  <wall pos="-4 0 -6" rot="0 90 0" length="6" height="2.8" thickness="0.2" material="wall">
    <opening type="door" x="4" width="1.0" height="2.1"/>
  </wall>

  <!-- front-left wall with a window -->
  <wall pos="-4 0 0" rot="0 90 0" length="6" height="2.8" thickness="0.2" material="wall">
    <opening type="window" x="2" width="1.4" height="1.2" sill="0.9"/>
  </wall>

  <!-- right wall, solid -->
  <wall pos="4 0 -3" length="6" height="2.8" thickness="0.2" material="wall"/>

  <!-- back-left wall, solid -->
  <wall pos="-4 0 -3" length="6" height="2.8" thickness="0.2" material="wall"/>

  <!-- window glass pane (thin box sitting in the opening) -->
  <box pos="-4 1.5 -1.5" size="1.3 1.1 0.03" material="glass" castShadow="0"/>

  <!-- ================= furniture ================= -->

  <!-- sofa: seat base + backrest + two arms, all boxes -->
  <group pos="-1.5 0 -5" rot="0 0 0">
    <box pos="0 0.25 0"   size="2.2 0.5 0.9"  material="fabric"/>
    <box pos="0 0.75 -0.4" size="2.2 0.5 0.15" material="fabric"/>
    <box pos="-1.05 0.55 0" size="0.15 0.55 0.9" material="fabric"/>
    <box pos=" 1.05 0.55 0" size="0.15 0.55 0.9" material="fabric"/>
  </group>

  <!-- coffee table: top + 4 legs (cylinders) -->
  <group pos="0.5 0 -3.5">
    <box pos="0 0.45 0" size="1.2 0.06 0.7" material="wood"/>
    <cylinder pos="-0.5 0.2 -0.28" radius="0.03" height="0.4" material="metal"/>
    <cylinder pos=" 0.5 0.2 -0.28" radius="0.03" height="0.4" material="metal"/>
    <cylinder pos="-0.5 0.2  0.28" radius="0.03" height="0.4" material="metal"/>
    <cylinder pos=" 0.5 0.2  0.28" radius="0.03" height="0.4" material="metal"/>
  </group>

  <!-- dining chair: 4-sided prism legs, box seat, box backrest -->
  <group pos="2.6 0 -1.2" rot="0 -30 0">
    <box pos="0 0.45 0" size="0.45 0.05 0.45" material="wood"/>
    <box pos="0 0.75 -0.2" size="0.45 0.55 0.05" material="wood"/>
    <prism pos="-0.18 0.22 -0.18" radius="0.025" height="0.45" sides="4" material="wood"/>
    <prism pos=" 0.18 0.22 -0.18" radius="0.025" height="0.45" sides="4" material="wood"/>
    <prism pos="-0.18 0.22  0.18" radius="0.025" height="0.45" sides="4" material="wood"/>
    <prism pos=" 0.18 0.22  0.18" radius="0.025" height="0.45" sides="4" material="wood"/>
  </group>

  <!-- decorative: torus "ring" side table base, sphere lamp shade, pyramid ornament -->
  <torus pos="2.6 0.15 -3.6" majorRadius="0.28" minorRadius="0.05" material="metal"/>
  <sphere pos="0.5 1.05 -3.5" radius="0.16" material="fabric"/>
  <pyramid pos="-3.0 0.25 -0.9" radius="0.35" height="0.5" material="wood"/>
</scene>
