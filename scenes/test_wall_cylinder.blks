<scene background="overcast">
  <camera name="Camera1" pos="0 1.5 6" look="0 1.5 0" fov="60"/>
  <sun dir="1 -1 0.5" color="1 0.95 0.85" intensity="1.2"/>

  <!-- Wall with a circular porthole punched through it -->
  <wall pos="0 0 0" length="6" height="3" thickness="0.3" material="wall"/>
  <bool-negative-cylinder pos="0 1.5 0" radius="0.6" depth="0.4"/>

  <!-- Floor -->
  <box pos="0 -0.05 0" size="8 0.1 6" material="floor"/>
</scene>
