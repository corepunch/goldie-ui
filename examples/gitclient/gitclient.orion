<?xml version="1.0" encoding="UTF-8"?>
<orion
    version="1"
    name="gitclient"
    title="Git Client"
    root="examples/gitclient">

    <menus var="kGCMenus" count="kGCMenuCount">
        <menu name="file" label="File">
            <item name="open_repo" label="Open Repository..." />
            <item name="clone" label="Clone..." />
            <Separator />
            <item name="quit" label="Exit" />
        </menu>

        <menu name="repo" label="Repo">
            <item name="refresh" label="Refresh" />
            <item name="terminal" label="Open Terminal Here" />
        </menu>

        <menu name="branch" label="Branch">
            <item name="new" label="New Branch..." />
            <item name="checkout" label="Checkout..." />
            <Separator />
            <item name="merge" label="Merge Into Current" />
            <item name="rebase" label="Rebase Current" />
            <Separator />
            <item name="delete" label="Delete..." />
        </menu>

        <menu name="commit" label="Commit">
            <item name="commit" label="Commit..." />
            <item name="amend" label="Amend Last Commit" />
            <Separator />
            <item name="stash" label="Stash Changes" />
            <item name="stash_pop" label="Pop Stash" />
        </menu>

        <menu name="remote" label="Remote">
            <item name="fetch" label="Fetch" />
            <item name="pull" label="Pull..." />
            <item name="push" label="Push..." />
            <Separator />
            <item name="manage" label="Manage Remotes..." />
        </menu>

        <menu name="help" label="Help">
            <item name="about" label="About Git Client" />
        </menu>
    </menus>

    <toolbars>
        <toolbar name="main">
            <Button name="fetch" menu="remote.fetch" icon="sysicon_arrow_down" text="Fetch" />
            <Button name="pull" menu="remote.pull" icon="sysicon_arrow_down" text="Pull" />
            <Button name="push" menu="remote.push" icon="sysicon_arrow_up" text="Push" />
            <spacer />
            <Button name="commit" menu="commit.commit" icon="sysicon_add" text="Commit" />
            <Button name="branch" menu="branch.new" icon="sysicon_star" text="Branch" />
            <spacer />
            <Button name="refresh" menu="repo.refresh" icon="sysicon_arrow_refresh" text="Refresh" />
            <Button name="open" menu="file.open_repo" icon="sysicon_folder" text="Open" />
        </toolbar>
    </toolbars>

    <databases>
        <database name="db" class="gitclient_db">
            <table name="branches">
                <field name="id" type="integer" key="YES"/>
                <field name="name" type="string" length="256"/>
                <field name="hash" type="string" length="41"/>
                <field name="is_current" type="bool"/>
                <field name="is_remote" type="bool"/>
            </table>

            <table name="commits">
                <field name="id" type="integer" key="YES"/>
                <field name="branch_id" type="integer" relation="branches.id"/>
                <field name="hash" type="string" length="41"/>
                <field name="author" type="string" length="64"/>
                <field name="date" type="string" length="20"/>
                <field name="subject" type="string" length="256"/>
            </table>

            <table name="files">
                <field name="id" type="integer" key="YES"/>
                <field name="commit_id" type="integer" relation="commits.id"/>
                <field name="path" type="string" length="512"/>
                <field name="status" type="string" length="2"/>
                <field name="staged" type="bool"/>
            </table>

            <table name="diff">
                <field name="id" type="integer" key="YES"/>
                <field name="content" type="string" length="262144"/>
            </table>
        </database>
    </databases>

    <plugins>
        <plugin name="gitclient_components" />
    </plugins>

    <forms>
        <form name="main_window"
              title="Git Client"
              width="960" height="640"
              flags="toolbar,statusbar"
              toolbar="main">
            <requires library="gitclient_components" />
            <stack orientation="horizontal" spacing="0" flags="flexspace">
                <TableView name="branches"
                           source="db.branches"
                           flags="notitle,nofill,vscroll"
                           width="180">
                    <Column field="name" title="" width="0" />
                </TableView>

                <stack orientation="vertical" spacing="0" flags="flexspace">
                    <TableView name="log"
                               source="db.commits"
                               flags="notitle,nofill,vscroll,flexspace">
                        <Column field="subject" title="Subject" width="0" />
                        <Column field="author" title="Author" width="110" />
                        <Column field="date" title="Date" width="90" />
                        <Column field="hash" title="Hash" width="50" />
                    </TableView>

                    <TableView name="files"
                               source="db.files"
                               flags="notitle,nofill,vscroll,flexspace">
                        <Column field="status" title="St" width="20" />
                        <Column field="path" title="File" width="0" />
                    </TableView>
                </stack>

                <DiffView name="diff"
                          flags="notitle,nofill,vscroll,flexspace"/>
            </stack>
        </form>

        <form name="commit_dialog"
              title="Commit"
              width="324"
              auto_layout="1"
              spacing="6"
              padding="8">
            <label text="Message:" />
            <multiedit name="msg" flags="vscroll,flexspace" />
            <stack orientation="horizontal" spacing="6">
                <checkbox name="amend" text="Amend last commit" />
                <space />
                <button name="ok" text="Commit" flags="default" />
                <button name="cancel" text="Cancel" />
            </stack>
        </form>

        <form name="new_branch_dialog"
              title="New Branch"
              width="276"
              auto_layout="1"
              spacing="6"
              padding="8">
            <stack orientation="horizontal" spacing="6">
                <label text="Name:" />
                <textedit name="name" flags="flexspace" />
            </stack>
            <stack orientation="horizontal" spacing="6">
                <label text="From:" />
                <combobox name="from" flags="flexspace" />
            </stack>
            <checkbox name="checkout" text="Checkout after creation" />
            <stack orientation="horizontal" spacing="6">
                <space />
                <button name="ok" text="Create" flags="default" />
                <button name="cancel" text="Cancel" />
            </stack>
        </form>

        <form name="push_pull_dialog"
              title="Remote Operation"
              width="262"
              auto_layout="1"
              spacing="6"
              padding="8">
            <stack orientation="horizontal" spacing="6">
                <label text="Remote:" />
                <combobox name="remote" flags="flexspace" />
            </stack>
            <stack orientation="horizontal" spacing="6">
                <label text="Branch:" />
                <combobox name="branch" flags="flexspace" />
            </stack>
            <checkbox name="prune" text="Prune deleted remote branches" />
            <checkbox name="force" text="Force" />
            <stack orientation="horizontal" spacing="6">
                <space />
                <button name="ok" text="OK" flags="default" />
                <button name="cancel" text="Cancel" />
            </stack>
        </form>
    </forms>
</orion>
