<?xml version="1.0" encoding="UTF-8"?>
<orion
    version="1"
    name="imageeditor"
    title="Image Editor Dialogs"
    root="examples/imageeditor">

    <plugins>
      <plugin name="formeditor_components" />
      <plugin name="imageeditor_components" />
    </plugins>

    <menus var="kMenus" count="kNumMenus">
      <menu name="file" label="File">
        <item name="new" label="New" />
        <item name="open" label="Open..." />
        <separator />
        <item name="save" label="Save" />
        <item name="saveas" label="Save As..." />
        <separator />
        <item name="close" label="Close" />
        <separator />
        <item name="quit" label="Quit" />
      </menu>

      <menu name="edit" label="Edit">
        <item name="undo" label="Undo" />
        <item name="redo" label="Redo" />
        <separator />
        <item name="cut" label="Cut" />
        <item name="copy" label="Copy" />
        <item name="paste" label="Paste" />
      </menu>

      <menu name="select" label="Select">
        <item name="all" label="All" />
        <item name="deselect" label="Deselect" />
        <separator />
        <item name="clear" label="Clear Selection" />
        <separator />
        <item name="expand" label="Expand..." />
        <item name="contract" label="Contract..." />
      </menu>

      <menu name="image" label="Image">
        <item name="crop" label="Crop" shortcut="C" />
        <separator />
        <item name="resize" label="Image Size..." />
        <item name="canvas_size" label="Canvas Size..." />
        <separator />
        <item name="flip_h" label="Flip Horizontal" />
        <item name="flip_v" label="Flip Vertical" />
        <separator />
        <item name="invert" label="Invert Colors" />
        <item name="levels" label="Levels..." />
      </menu>

      <menu name="filter" label="Filter" dynamic="true">
        <item name="reload" label="Reload Filters" />
        <item name="gallery" label="Filter Gallery..." />
        <separator />
        <submenu name="blur" label="Blur">
          <item name="blur" label="Blur" />
        </submenu>
        <submenu name="sharpen" label="Sharpen">
          <item name="sharpen" label="Sharpen" />
        </submenu>
        <submenu name="stylize" label="Stylize">
          <item name="edge" label="Find Edges" />
        </submenu>
        <submenu name="photo" label="Photo" />
      </menu>

      <menu name="layer" label="Layer">
        <item name="new" label="New Layer" />
        <item name="duplicate" label="Duplicate Layer" />
        <item name="delete" label="Delete Layer" />
        <separator />
        <item name="move_up" label="Move Layer Up" />
        <item name="move_down" label="Move Layer Down" />
        <separator />
        <item name="merge_down" label="Merge Down" />
        <item name="flatten" label="Flatten Image" />
        <item name="fill_foreground" label="Fill with Foreground Color" shortcut="Alt+Backspace" />
        <item name="fill_background" label="Fill with Background Color" shortcut="Ctrl+Backspace" />
        <separator />
        <item name="add_mask" label="Add Mask" />
        <item name="apply_mask" label="Apply Mask" />
        <item name="remove_mask" label="Remove Mask" />
        <item name="extract_mask" label="Extract Mask" />
        <separator />
        <item name="edit_mask" label="[ ] Edit Mask" />
      </menu>

      <menu name="view" label="View" mutable="true">
        <item name="zoom_in" label="Zoom In" />
        <item name="zoom_out" label="Zoom Out" />
        <item name="zoom_fit" label="Fit on Screen" />
        <separator />
        <item name="zoom_1x" label="1x" />
        <item name="zoom_2x" label="2x" />
        <item name="zoom_4x" label="4x" />
        <item name="zoom_6x" label="6x" />
        <item name="zoom_8x" label="8x" />
        <separator />
        <item name="show_grid" label="[ ] Show Grid" />
        <item name="snap_grid" label="[ ] Snap to Grid" />
        <item name="show_background" label="[x] Show Background" />
        <item name="mask_only" label="[ ] Mask Only View" />
        <separator />
        <item name="grid_options" label="Grid Options..." />
      </menu>

      <menu name="window" label="Window" dynamic="true">
        <item name="tools" label="Tools" />
        <item name="colors" label="Colors" />
        <item name="layers" label="Layers" />
        <item name="timeline" label="Timeline" />
        <separator />
      </menu>

      <menu name="anim" label="Anim">
        <item name="new_frame" label="New Frame" />
        <item name="duplicate_frame" label="Duplicate Frame" />
        <item name="delete_frame" label="Delete Frame" />
        <separator />
        <item name="prev_frame" label="Previous Frame" shortcut="Page Up" />
        <item name="next_frame" label="Next Frame" shortcut="Page Down" />
        <separator />
        <item name="play" label="Play" />
        <item name="stop" label="Stop" />
        <item name="loop" label="[ ] Loop" />
        <separator />
        <item name="export_gif" label="Export GIF..." />
        <item name="export_apng" label="Export APNG..." />
        <item name="export_spritesheet" label="Export Sprite Sheet..." />
        <item name="set_fps" label="Set FPS..." />
      </menu>

      <menu name="help" label="Help">
        <item name="about" label="About..." />
      </menu>
    </menus>

    <toolbars>
      <toolbar name="main">
        <button name="new" menu="file" icon="sysicon_page_add" text="New" />
        <button name="open" menu="file" icon="sysicon_folder_page" text="Open" />
        <button name="save" menu="file" icon="sysicon_disk_save" text="Save" />
        <button name="saveas" menu="file" icon="sysicon_disk_multiple" text="Save As" />
        <spacer w="10" />
        <button name="zoom_out" menu="view" icon="sysicon_magnifier_zoom_out" text="Zoom Out" />
        <button name="zoom_in" menu="view" icon="sysicon_magnifier_zoom_in" text="Zoom In" />
        <button name="zoom_1x" menu="view" icon="sysicon_image_dimensions" text="1x" />
        <button name="zoom_fit" menu="view" icon="sysicon_expand" text="Fit" />
        <spacer w="10" />
        <button name="show_background" menu="view" icon="sysicon_eye_show" flags="BUTTON_PUSHLIKE" text="BG" />
        <button name="mask_only" menu="view" icon="sysicon_transparency" flags="BUTTON_PUSHLIKE" text="Mask" />
      </toolbar>
    </toolbars>

    <forms>
      <form name="new_image"
            title="New Image"
            frame="0 0 180 84"
            flags="0"
>
          <label name="lbl_width" text="Width:" frame="4 8 56 13" flags="0" />
          <label name="lbl_height" text="Height:" frame="4 29 56 13" flags="0" />
          <textedit name="width" value="1" text="" frame="62 8 56 13" flags="0" />
          <textedit name="height" value="2" text="" frame="62 29 56 13" flags="0" />
          <button name="ok" value="3" text="OK" frame="92 54 40 19" flags="BUTTON_DEFAULT" />
          <button name="cancel" value="4" text="Cancel" frame="136 54 40 19" flags="0" />
      </form>

      <form name="image_resize"
            title="Image Size"
            frame="0 0 210 104"
            flags="0"
>
          <label name="lbl_width" text="Width:" frame="4 8 44 13" flags="0" />
          <textedit name="width" value="1" text="" frame="54 8 72 13" flags="0" />
          <label name="lbl_height" text="Height:" frame="4 29 44 13" flags="0" />
          <textedit name="height" value="2" text="" frame="54 29 72 13" flags="0" />
          <label name="lbl_filter" text="Filter:" frame="4 50 44 13" flags="0" />
          <combobox name="filter" value="3" text="" frame="54 50 150 13" flags="0" />
          <button name="ok" value="4" text="OK" frame="112 79 44 19" flags="BUTTON_DEFAULT" />
          <button name="cancel" value="5" text="Cancel" frame="160 79 46 19" flags="0" />
      </form>

      <form name="grid_options"
            title="Grid Options"
            frame="0 0 180 84"
            flags="0"
>
          <label name="lbl_h" value="5" text="Horizontal:" frame="4 9 66 13" flags="0" />
          <label name="lbl_v" value="6" text="Vertical:" frame="4 26 66 13" flags="0" />
          <textedit name="gridx" value="1" text="" frame="74 8 56 13" flags="0" />
          <textedit name="gridy" value="2" text="" frame="74 25 56 13" flags="0" />
          <button name="ok" value="3" text="OK" frame="92 44 40 19" flags="BUTTON_DEFAULT" />
          <button name="cancel" value="4" text="Cancel" frame="136 44 40 19" flags="0" />
      </form>

      <form name="selection_modify"
            title="Modify Selection"
            frame="0 0 180 68"
            flags="0"
>
          <label name="lbl_amount" text="By:" frame="8 10 34 13" flags="0" />
          <textedit name="amount" value="1" text="" frame="44 9 56 13" flags="0" />
          <label name="lbl_pixels" text="pixels" frame="106 10 44 13" flags="0" />
          <button name="ok" value="2" text="OK" frame="84 35 44 19" flags="BUTTON_DEFAULT" />
          <button name="cancel" value="3" text="Cancel" frame="132 35 44 19" flags="0" />
      </form>

      <form name="new_layer"
            title="New Layer"
            frame="0 0 200 68"
            flags="0"
>
          <label name="lbl_fill" text="Fill with:" frame="4 8 48 13" flags="0" />
          <combobox name="combo_fill" value="1" text="" frame="54 8 138 13" flags="0" />
          <button name="ok" value="2" text="OK" frame="104 33 44 19" flags="BUTTON_DEFAULT" />
          <button name="cancel" value="3" text="Cancel" frame="152 33 44 19" flags="0" />
      </form>

      <form name="add_mask"
            title="Add Mask"
            frame="0 0 220 68"
            flags="0"
>
          <label name="lbl_fill" text="Fill with:" frame="4 10 64 13" flags="0" />
          <combobox name="combo_fill" value="1" text="" frame="70 10 140 13" flags="0" />
          <button name="ok" value="2" text="OK" frame="124 35 44 19" flags="BUTTON_DEFAULT" />
          <button name="cancel" value="3" text="Cancel" frame="172 35 44 19" flags="0" />
      </form>

      <form name="text_tool"
            title="Insert Text"
            frame="0 0 220 96"
            flags="0"
>
          <label name="lbl_text" text="Text:" frame="2 3 36 13" flags="0" />
          <textedit name="edit_text" value="1" text="" frame="2 12 216 13" flags="0" />
          <label name="lbl_size" value="7" text="Size: 16px" frame="2 30 80 13" flags="0" />
          <slider name="size" value="8" text="" frame="2 36 216 17" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
          <label name="lbl_color" text="Color:" frame="2 55 36 13" flags="0" />
          <space name="swatch" value="6" text="" frame="40 53 14 11" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
          <button name="btn_color" value="4" text="Change..." frame="58 52 54 19" flags="0" />
          <checkbox name="chk_aa" value="5" text="Anti-alias" frame="118 53 74 12" flags="0" />
          <button name="btn_ok" value="2" text="OK" frame="2 71 38 19" flags="0" />
          <button name="btn_cancel" value="3" text="Cancel" frame="44 71 50 19" flags="0" />
      </form>

      <form name="levels"
            title="Levels"
            frame="0 0 280 222"
            flags="0"
>
        <requires library="imageeditor_components" />
          <label name="in_label" text="Input Levels:" frame="10 4 0 13" flags="WINDOW_NOTITLE | WINDOW_NOFILL" />
          <textedit name="in_black" text="0" frame="84 0 34 13" flags="0" />
          <textedit name="in_gamma" text="1.00" frame="122 0 34 13" flags="0" />
          <textedit name="in_white" text="255" frame="160 0 34 13" flags="0" />
          <lv_histogram name="graph" text="" frame="10 21 260 84" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
          <slider name="in_slider" text="" frame="10 107 260 13" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
          <label name="out_label" text="Output Levels:" frame="10 128 0 13" flags="WINDOW_NOTITLE | WINDOW_NOFILL" />
          <textedit name="out_black" text="0" frame="84 128 34 13" flags="0" />
          <textedit name="out_white" text="255" frame="160 128 34 13" flags="0" />
          <gradient name="out_grad" text="" frame="18 146 244 8" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
          <slider name="out_slider" text="" frame="10 156 260 13" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
          <checkbox name="preview" text="Preview" frame="10 178 74 12" flags="0" />
          <button name="ok" text="OK" frame="116 198 48 19" flags="0" />
          <button name="reset" text="Reset" frame="168 198 48 19" flags="0" />
          <button name="cancel" text="Cancel" frame="220 198 48 19" flags="0" />
      </form>

      <form name="filter_gallery"
            title="Filter Gallery"
            frame="0 0 560 360"
            flags="WINDOW_DIALOG | WINDOW_NOTRAYBUTTON"
>
        <requires library="imageeditor_components" />
          <filter_preview name="preview" value="4002" text="" frame="14 18 248 248" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
          <label name="filter_name" value="4003" text="No filters loaded" frame="14 276 248 13" flags="WINDOW_NOTITLE | WINDOW_NOFILL" />
          <reportview name="filters" value="4001" text="" frame="286 18 256 290" flags="WINDOW_NOTITLE | WINDOW_NORESIZE" />
          <button name="ok" value="5001" text="OK" frame="404 326 66 19" flags="BUTTON_DEFAULT" />
          <button name="cancel" value="5002" text="Cancel" frame="478 326 66 19" flags="0" />
      </form>

      <form name="blur_dialog"
            title="Blur"
            frame="0 0 240 96"
            flags="WINDOW_DIALOG | WINDOW_NOTRAYBUTTON"
>
          <label name="amount_label" value="1" text="Blur: 4px" frame="10 8 220 13" flags="WINDOW_NOTITLE | WINDOW_NOFILL" />
          <slider name="amount" value="2" text="" frame="10 26 220 13" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
          <checkbox name="preview" value="3" text="Preview" frame="10 48 74 12" flags="0" />
          <button name="ok" value="4" text="OK" frame="92 68 44 19" flags="BUTTON_DEFAULT" />
          <button name="cancel" value="5" text="Cancel" frame="140 68 56 19" flags="0" />
      </form>
    </forms>
</orion>
