<?xml version="1.0" encoding="UTF-8"?>
<orion
    version="1"
    name="imageeditor"
    title="Image Editor Dialogs"
    root="examples/imageeditor">

    <plugins>
      <plugin name="formeditor_components" />
      <plugin name="imageeditor_components" />
    </plugins>

    <menus var="kMenus" count="kNumMenus">
      <menu name="file" label="File">
        <item name="new" label="New" />
        <item name="open" label="Open..." />
        <separator />
        <item name="save" label="Save" />
        <item name="saveas" label="Save As..." />
        <separator />
        <item name="close" label="Close" />
        <separator />
        <item name="quit" label="Quit" />
      </menu>

      <menu name="edit" label="Edit">
        <item name="undo" label="Undo" />
        <item name="redo" label="Redo" />
        <separator />
        <item name="cut" label="Cut" />
        <item name="copy" label="Copy" />
        <item name="paste" label="Paste" />
      </menu>

      <menu name="select" label="Select">
        <item name="all" label="All" />
        <item name="deselect" label="Deselect" />
        <separator />
        <item name="clear" label="Clear Selection" />
        <separator />
        <item name="expand" label="Expand..." />
        <item name="contract" label="Contract..." />
      </menu>

      <menu name="image" label="Image">
        <item name="crop" label="Crop" shortcut="C" />
        <separator />
        <item name="resize" label="Image Size..." />
        <item name="canvas_size" label="Canvas Size..." />
        <separator />
        <item name="flip_h" label="Flip Horizontal" />
        <item name="flip_v" label="Flip Vertical" />
        <separator />
        <item name="invert" label="Invert Colors" />
        <item name="levels" label="Levels..." />
      </menu>

      <menu name="filter" label="Filter" dynamic="true">
        <item name="reload" label="Reload Filters" />
        <item name="gallery" label="Filter Gallery..." />
        <separator />
        <submenu name="blur" label="Blur">
          <item name="blur" label="Blur" />
        </submenu>
        <submenu name="sharpen" label="Sharpen">
          <item name="sharpen" label="Sharpen" />
        </submenu>
        <submenu name="stylize" label="Stylize">
          <item name="edge" label="Find Edges" />
        </submenu>
        <submenu name="photo" label="Photo" />
      </menu>

      <menu name="layer" label="Layer">
        <item name="new" label="New Layer" />
        <item name="duplicate" label="Duplicate Layer" />
        <item name="delete" label="Delete Layer" />
        <separator />
        <item name="move_up" label="Move Layer Up" />
        <item name="move_down" label="Move Layer Down" />
        <separator />
        <item name="merge_down" label="Merge Down" />
        <item name="flatten" label="Flatten Image" />
        <item name="fill_foreground" label="Fill with Foreground Color" shortcut="Alt+Backspace" />
        <item name="fill_background" label="Fill with Background Color" shortcut="Ctrl+Backspace" />
        <separator />
        <item name="add_mask" label="Add Mask" />
        <item name="apply_mask" label="Apply Mask" />
        <item name="remove_mask" label="Remove Mask" />
        <item name="extract_mask" label="Extract Mask" />
        <separator />
        <item name="edit_mask" label="[ ] Edit Mask" />
      </menu>

      <menu name="view" label="View" mutable="true">
        <item name="zoom_in" label="Zoom In" />
        <item name="zoom_out" label="Zoom Out" />
        <item name="zoom_fit" label="Fit on Screen" />
        <separator />
        <item name="zoom_1x" label="1x" />
        <item name="zoom_2x" label="2x" />
        <item name="zoom_4x" label="4x" />
        <item name="zoom_6x" label="6x" />
        <item name="zoom_8x" label="8x" />
        <separator />
        <item name="show_grid" label="[ ] Show Grid" />
        <item name="snap_grid" label="[ ] Snap to Grid" />
        <item name="show_background" label="[x] Show Background" />
        <item name="mask_only" label="[ ] Mask Only View" />
        <separator />
        <item name="grid_options" label="Grid Options..." />
      </menu>

      <menu name="window" label="Window" dynamic="true">
        <item name="tools" label="Tools" />
        <item name="colors" label="Colors" />
        <item name="layers" label="Layers" />
        <item name="timeline" label="Timeline" />
        <separator />
      </menu>

      <menu name="anim" label="Anim">
        <item name="new_frame" label="New Frame" />
        <item name="duplicate_frame" label="Duplicate Frame" />
        <item name="delete_frame" label="Delete Frame" />
        <separator />
        <item name="prev_frame" label="Previous Frame" shortcut="Page Up" />
        <item name="next_frame" label="Next Frame" shortcut="Page Down" />
        <separator />
        <item name="play" label="Play" />
        <item name="stop" label="Stop" />
        <item name="loop" label="[ ] Loop" />
        <item name="onion_skin" label="Onion Skin Settings..." />
        <separator />
        <item name="export_gif" label="Export GIF..." />
        <item name="export_apng" label="Export APNG..." />
        <item name="export_spritesheet" label="Export Sprite Sheet..." />
        <item name="set_fps" label="Set FPS..." />
      </menu>

      <menu name="help" label="Help">
        <item name="about" label="About..." />
      </menu>
    </menus>

    <toolbars>
      <toolbar name="main">
        <button name="new" menu="file" icon="sysicon_page_add" text="New" />
        <button name="open" menu="file" icon="sysicon_folder_page" text="Open" />
        <button name="save" menu="file" icon="sysicon_disk_save" text="Save" />
        <button name="saveas" menu="file" icon="sysicon_disk_multiple" text="Save As" />
        <spacer w="10" />
        <button name="zoom_out" menu="view" icon="sysicon_magnifier_zoom_out" text="Zoom Out" />
        <button name="zoom_in" menu="view" icon="sysicon_magnifier_zoom_in" text="Zoom In" />
        <button name="zoom_1x" menu="view" icon="sysicon_image_dimensions" text="1x" />
        <button name="zoom_fit" menu="view" icon="sysicon_expand" text="Fit" />
        <spacer w="10" />
        <button name="show_background" menu="view" icon="sysicon_eye_show" flags="BUTTON_PUSHLIKE" text="BG" />
        <button name="mask_only" menu="view" icon="sysicon_transparency" flags="BUTTON_PUSHLIKE" text="Mask" />
      </toolbar>
    </toolbars>

    <forms>
      <form name="new_image"
            title="New Image"
            frame="0 0 180 84"
            flags="0"
            auto_layout="1"
            spacing="8"
            padding="8">
        <grid name="fields" spacing="4">
          <column name="labels" width="48">
            <label name="lbl_width" text="Width:" flags="0" />
            <label name="lbl_height" text="Height:" flags="0" />
          </column>
          <column name="inputs" flags="WINDOW_FLEXSPACE">
            <textedit name="width" text="" flags="0" />
            <textedit name="height" text="" flags="0" />
          </column>
        </grid>
        <separator name="sep" />
        <stack name="actions" orientation="horizontal" spacing="6">
          <space name="flex" />
          <button name="ok" text="OK" flags="BUTTON_DEFAULT" />
          <button name="cancel" text="Cancel" flags="0" />
        </stack>
      </form>

      <form name="image_resize"
            title="Image Size"
            frame="0 0 210 104"
            flags="0"
            auto_layout="1"
            spacing="8"
            padding="8">
        <grid name="fields" spacing="4">
          <column name="labels" width="48">
            <label name="lbl_width" text="Width:" flags="0" />
            <label name="lbl_height" text="Height:" flags="0" />
            <label name="lbl_filter" text="Filter:" flags="0" />
          </column>
          <column name="inputs" flags="WINDOW_FLEXSPACE">
            <textedit name="width" text="" flags="0" />
            <textedit name="height" text="" flags="0" />
            <combobox name="filter" text="" flags="0" />
          </column>
        </grid>
        <separator name="sep" />
        <stack name="actions" orientation="horizontal" spacing="6">
          <space name="flex" />
          <button name="ok" text="OK" flags="BUTTON_DEFAULT" />
          <button name="cancel" text="Cancel" flags="0" />
        </stack>
      </form>

      <form name="grid_options"
            title="Grid Options"
            frame="0 0 180 94"
            flags="0"
            auto_layout="1"
            spacing="8"
            padding="8">
        <grid name="fields" spacing="4">
          <column name="labels" width="48">
            <label name="lbl_width" text="Width:" flags="0" />
            <label name="lbl_height" text="Height:" flags="0" />
          </column>
          <column name="inputs" flags="WINDOW_FLEXSPACE">
            <textedit name="width" text="" flags="0" />
            <textedit name="height" text="" flags="0" />
          </column>
        </grid>
        <separator name="sep" />
        <stack name="actions" orientation="horizontal" spacing="6">
          <space name="flex" />
          <button name="ok" text="OK" flags="BUTTON_DEFAULT" />
          <button name="cancel" text="Cancel" flags="0" />
        </stack>
      </form>

      <form name="selection_modify"
            title="Modify Selection"
            frame="0 0 180 68"
            flags="0"
            auto_layout="1"
            spacing="8"
            padding="8">
        <stack name="amount_row" orientation="horizontal" spacing="6">
          <label name="lbl_amount" text="By:" flags="0" />
          <textedit name="amount" text="" flags="WINDOW_FLEXSPACE" />
          <label name="lbl_pixels" text="pixels" flags="0" />
        </stack>
        <separator name="sep" />
        <stack name="actions" orientation="horizontal" spacing="6">
          <space name="flex" />
          <button name="ok" text="OK" flags="BUTTON_DEFAULT" />
          <button name="cancel" text="Cancel" flags="0" />
        </stack>
      </form>

      <form name="new_layer"
            title="New Layer"
            frame="0 0 200 68"
            flags="0"
            auto_layout="1"
            spacing="8"
            padding="8">
        <stack name="fill_row" orientation="horizontal" spacing="6">
          <label name="lbl_fill" text="Fill with:" flags="0" />
          <combobox name="combo_fill" text="" flags="WINDOW_FLEXSPACE" />
        </stack>
        <stack name="actions" orientation="horizontal" spacing="6">
          <space name="flex" />
          <button name="ok" text="OK" flags="BUTTON_DEFAULT" />
          <button name="cancel" text="Cancel" flags="0" />
        </stack>
      </form>

      <form name="add_mask"
            title="Add Mask"
            frame="0 0 220 68"
            flags="0"
            auto_layout="1"
            spacing="8"
            padding="8">
        <stack name="fill_row" orientation="horizontal" spacing="6">
          <label name="lbl_fill" text="Fill with:" flags="0" />
          <combobox name="combo_fill" text="" flags="WINDOW_FLEXSPACE" />
        </stack>
        <separator name="sep" />
        <stack name="actions" orientation="horizontal" spacing="6">
          <space name="flex" />
          <button name="ok" text="OK" flags="BUTTON_DEFAULT" />
          <button name="cancel" text="Cancel" flags="0" />
        </stack>
      </form>

      <form name="text_tool"
            title="Insert Text"
            frame="0 0 220 96"
            flags="0"
            auto_layout="1"
            spacing="6"
            padding="8">
        <stack name="text_row" orientation="horizontal" spacing="6">
          <label name="lbl_text" text="Text:" flags="0" />
          <textedit name="edit_text" text="" flags="WINDOW_FLEXSPACE" />
        </stack>
        <stack name="size_row" orientation="vertical" spacing="2">
          <label name="lbl_size" text="Size: 16px" flags="0" />
          <slider name="size" text="" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
        </stack>
        <stack name="color_row" orientation="horizontal" spacing="6">
          <label name="lbl_color" text="Color:" flags="0" />
          <space name="swatch" text="" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
          <button name="btn_color" text="Change..." flags="0" />
          <checkbox name="chk_aa" text="Anti-alias" flags="0" />
        </stack>
        <separator name="sep" />
        <stack name="actions" orientation="horizontal" spacing="6">
          <space name="flex" />
          <button name="btn_ok" text="OK" flags="0" />
          <button name="btn_cancel" text="Cancel" flags="0" />
        </stack>
      </form>

      <form name="levels"
            title="Levels"
            frame="0 0 280 222"
            flags="0"
            auto_layout="1"
            spacing="6"
            padding="10">
        <requires library="imageeditor_components" />
        <grid name="input_row" spacing="4">
          <column name="in_label_col" width="72">
            <label name="in_label" text="Input Levels:" flags="WINDOW_NOTITLE | WINDOW_NOFILL" />
          </column>
          <column name="in_black_col">
            <textedit name="in_black" text="0" flags="0" />
          </column>
          <column name="in_gamma_col">
            <textedit name="in_gamma" text="1.00" flags="0" />
          </column>
          <column name="in_white_col">
            <textedit name="in_white" text="255" flags="0" />
          </column>
        </grid>
        <lv_histogram name="graph" text="" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
        <slider name="in_slider" text="" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
        <grid name="output_row" spacing="4">
          <column name="out_label_col" width="80">
            <label name="out_label" text="Output Levels:" flags="WINDOW_NOTITLE | WINDOW_NOFILL" />
          </column>
          <column name="out_black_col">
            <textedit name="out_black" text="0" flags="0" />
          </column>
          <column name="out_white_col">
            <textedit name="out_white" text="255" flags="0" />
          </column>
        </grid>
        <gradient name="out_grad" text="" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
        <slider name="out_slider" text="" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
        <checkbox name="preview" text="Preview" flags="0" />
        <separator name="sep" />
        <stack name="actions" orientation="horizontal" spacing="6">
          <space name="flex" />
          <button name="ok" text="OK" flags="0" />
          <button name="reset" text="Reset" flags="0" />
          <button name="cancel" text="Cancel" flags="0" />
        </stack>
      </form>

      <form name="filter_gallery"
            title="Filter Gallery"
            frame="0 0 560 360"
            flags="WINDOW_DIALOG | WINDOW_NOTRAYBUTTON"
            auto_layout="1"
            padding="8"
>
        <requires library="imageeditor_components" />
        <grid name="main" spacing="8" flags="WINDOW_FLEXSPACE">
          <column name="preview_col">
            <filter_preview name="preview" text="" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
            <label name="filter_name" text="No filters loaded" flags="WINDOW_NOTITLE | WINDOW_NOFILL" />
          </column>
          <column name="filters_col">
            <reportview name="filters" text="" flags="WINDOW_NOTITLE | WINDOW_NORESIZE | WINDOW_VSCROLL" />
          </column>
        </grid>
        <stack name="actions" orientation="horizontal" spacing="6">
          <space name="flex" />
          <button name="ok" text="OK" flags="BUTTON_DEFAULT" />
          <button name="cancel" text="Cancel" flags="0" />
        </stack>
      </form>

      <form name="blur_dialog"
            title="Blur"
            frame="0 0 240 96"
            flags="WINDOW_DIALOG | WINDOW_NOTRAYBUTTON"
            auto_layout="1"
            spacing="6"
            padding="10">
        <stack name="amount_row" orientation="vertical" spacing="2">
          <label name="amount_label" text="Blur: 4px" flags="WINDOW_NOTITLE | WINDOW_NOFILL" />
          <slider name="amount" text="" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
        </stack>
        <checkbox name="preview" text="Preview" flags="0" />
        <separator name="sep" />
        <stack name="actions" orientation="horizontal" spacing="6">
          <space name="flex" />
          <button name="ok" text="OK" flags="BUTTON_DEFAULT" />
          <button name="cancel" text="Cancel" flags="0" />
        </stack>
      </form>

      <form name="onion_skin"
            title="Onion Skin"
            x="0"
            y="0"
            width="276"
            height="142"
            flags="0"
            auto_layout="1"
            spacing="6"
            padding="8">
        <checkbox name="enabled" text="Enable Onion Skin" flags="0" />
        <label name="selected_label" text="Selected: Previous 1 (40%)" flags="0" />
        <stack name="prev_row" orientation="horizontal" spacing="4">
          <label name="prev_label" text="Prev" width="30" />
          <button name="prev1" text="40%" width="44" flags="BUTTON_PUSHLIKE" />
          <button name="prev2" text="20%" width="44" flags="BUTTON_PUSHLIKE" />
          <button name="prev3" text="10%" width="44" flags="BUTTON_PUSHLIKE" />
          <button name="prev4" text="5%" width="44" flags="BUTTON_PUSHLIKE" />
        </stack>
        <stack name="next_row" orientation="horizontal" spacing="4">
          <label name="next_label" text="Next" width="30" />
          <button name="next1" text="30%" width="44" flags="BUTTON_PUSHLIKE" />
          <button name="next2" text="15%" width="44" flags="BUTTON_PUSHLIKE" />
          <button name="next3" text="8%" width="44" flags="BUTTON_PUSHLIKE" />
          <button name="next4" text="4%" width="44" flags="BUTTON_PUSHLIKE" />
        </stack>
        <stack name="value_row" orientation="vertical" spacing="2">
          <label name="value_label" text="Opacity: 40%" flags="0" />
          <slider name="value" text="" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_NOTABSTOP" />
        </stack>
        <separator name="sep" />
        <stack name="actions" orientation="horizontal" spacing="6">
          <space name="flex" />
          <button name="ok" text="OK" flags="BUTTON_DEFAULT" />
          <button name="cancel" text="Cancel" flags="0" />
        </stack>
      </form>

      <form name="about"
            title="About Orion Image Editor"
            frame="0 0 270 120"
            flags="0"
            auto_layout="1"
            orientation="horizontal"
            spacing="8"
            padding="0">
        <image name="banner" width="120" height="120" />
        <stack name="info" flags="WINDOW_FLEXSPACE" spacing="2" padding="0 8 4 4">
          <label name="title" text="Orion Image Editor" font="system" />
          <label name="version" text="Version 1.0" color="text-disabled" />
          <label name="desc1" text="A MacPaint-inspired" color="text-disabled" />
          <label name="desc2" text="pixel art editor." color="text-disabled" />
          <label name="desc3" text="Built with the" color="text-disabled" />
          <label name="desc4" text="Orion UI framework." color="text-disabled" />
          <space name="spacer" />
          <stack name="actions" orientation="horizontal" spacing="6">
            <space name="flex" />
            <button name="ok" text="OK" width="50" height="19" flags="BUTTON_DEFAULT" />
          </stack>
        </stack>
      </form>

      <form name="color_picker"
            title="Edit Color"
            frame="0 0 240 128"
            flags="0"
            auto_layout="1"
            spacing="0"
            padding="0">
        <cp_surface name="surface" width="240" height="104" />
        <stack name="actions" orientation="horizontal" spacing="2">
          <button name="ok" text="OK" width="40" height="19" flags="BUTTON_DEFAULT" />
          <button name="cancel" text="Cancel" width="48" height="19" />
          <button name="add_palette" text="+ Palette" width="62" height="19" />
          <space name="flex" />
        </stack>
      </form>
    </forms>
</orion>
