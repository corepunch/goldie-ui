<?xml version="1.0" encoding="UTF-8"?>
<orion
    version="1"
    name="socialfeed"
    title="Social Feed Dialogs"
    root="examples/socialfeed">

    <menus var="kMenus" count="kNumMenus">
      <menu name="file" label="File">
        <item name="quit" label="Quit" />
      </menu>

      <menu name="post" label="Post">
        <item name="new" label="New Post..." />
        <item name="like" label="Like Post" />
        <item name="view" label="View Post..." />
        <separator />
        <item name="delete" label="Delete Post" />
      </menu>

      <menu name="view" label="View">
        <item name="refresh" label="Refresh" />
      </menu>

      <menu name="help" label="Help">
        <item name="about" label="About..." />
      </menu>
    </menus>

    <toolbars>
      <toolbar name="feed">
        <button name="new" menu="post" icon="sysicon_add" text="New Post" />
        <button name="like" menu="post" icon="sysicon_heart" text="Like" />
        <button name="view" menu="post" icon="sysicon_comment" text="View Post" />
        <spacer />
        <button name="delete" menu="post" icon="sysicon_delete" text="Delete" />
      </toolbar>
    </toolbars>

    <database>
      <source name="feed_posts" model="post" />
      <binding name="feed_posts_report" source="feed_posts" view="feed">
        <column field="title" title="Title" width="0" />
        <column field="author" title="Author" width="80" />
        <column field="like_count" title="Likes" width="50" />
        <column field="comment_count" title="Comments" width="55" />
      </binding>
      <action name="fetch_feed" type="fetch" source="feed_posts" target="feed" />
    </database>

    <forms>
      <form name="new_post"
            title="New Post"
            width="272" height="250"
            spacing="0"
            padding="8">
        <grid name="fields" spacing="4">
          <column name="labels" width="56">
            <label name="lbl_author" text="Author:" />
            <label name="lbl_title" text="Title:" />
            <label name="lbl_body" text="Body:" />
          </column>
          <column name="inputs">
            <textedit name="author" />
            <textedit name="title" />
            <multiedit name="body" />
          </column>
        </grid>
        <separator name="section_sep" />
        <stack name="actions" orientation="horizontal" spacing="6">
          <space name="flex_left" />
          <button name="ok" text="Post" flags="BUTTON_DEFAULT" />
          <button name="cancel" text="Cancel" />
          <space name="flex_right" />
        </stack>
      </form>

      <form name="new_comment"
            title="New Comment"
            width="260"
            padding="8">
        <stack name="author_row" orientation="horizontal" spacing="6">
          <label name="lbl_author" text="Author:" />
          <textedit name="author" />
        </stack>

        <stack name="text_row" orientation="horizontal" spacing="6">
          <label name="lbl_text" text="Text:" />
          <textedit name="text" />
        </stack>

        <separator name="sep" />
        <stack name="actions" orientation="horizontal" spacing="6">
          <button name="ok" text="Submit" flags="BUTTON_DEFAULT" />
          <space name="flex" />
          <button name="cancel" text="Cancel" />
        </stack>
      </form>

      <form name="post_detail"
            title="Post Detail"
            width="520" height="336"
            padding="8">
        <stack name="header" orientation="vertical" spacing="2">
          <!-- Post header labels (populated in evCreate) -->
          <label name="lbl_title" font="system" color="text-normal" />
          <label name="lbl_body" font="small" color="text-normal" />
          <stack name="meta" orientation="horizontal" spacing="8">
            <label name="lbl_author" font="small" color="text-disabled" />
            <label name="lbl_likes" font="small" color="text-disabled" />
            <label name="lbl_cmt_hdr" font="small" color="text-disabled" />
          </stack>
        </stack>

        <!-- Comments reportview -->
        <reportview name="comments" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_VSCROLL | WINDOW_FLEXSPACE" />

        <separator name="section_sep" />

        <stack name="actions" orientation="horizontal" spacing="4">
          <button name="like_post" text="Like Post" />
          <button name="add_comment" text="Add Comment" />
          <button name="add_reply" text="Add Reply" />
          <button name="like_comment" text="Like Comment" />
          <space name="flex" />
          <button name="close" text="Close" flags="BUTTON_DEFAULT" />
        </stack>
      </form>
    </forms>
</orion>
