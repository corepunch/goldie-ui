<?xml version="1.0" encoding="UTF-8"?>
<orion
    version="1"
    name="socialfeed"
    title="Social Feed Dialogs"
    root="examples/socialfeed">

    <menus var="kMenus" count="kNumMenus">
      <menu name="file" label="File">
        <item name="quit" label="Quit" />
      </menu>

      <menu name="post" label="Post">
        <item name="new" label="New Post..." />
        <item name="like" label="Like Post" />
        <item name="view" label="View Post..." />
        <separator />
        <item name="delete" label="Delete Post" />
      </menu>

      <menu name="view" label="View">
        <item name="refresh" label="Refresh" />
      </menu>

      <menu name="help" label="Help">
        <item name="about" label="About..." />
      </menu>
    </menus>

    <toolbars>
      <toolbar name="feed">
        <button name="new" menu="post" icon="sysicon_add" text="New Post" />
        <button name="like" menu="post" icon="sysicon_heart" text="Like" />
        <button name="view" menu="post" icon="sysicon_comment" text="View Post" />
        <spacer />
        <button name="delete" menu="post" icon="sysicon_delete" text="Delete" />
      </toolbar>
    </toolbars>

    <forms>
      <form name="new_post"
            title="New Post"
            frame="0 0 272 250"
            flags="0"
            auto_layout="1"
            spacing="0"
            padding="8"
>
        <grid name="fields" columns="2" spacing="4" flags="WINDOW_FLEXSPACE" v-align="stretch">
          <label name="lbl_author" text="Author:" />
          <textedit name="author" text="" />
          <label name="lbl_title" text="Title:" />
          <textedit name="title" text="" />
          <label name="lbl_body" text="Body:" />
          <multiedit name="body" text="" flags="WINDOW_VSCROLL | WINDOW_FLEXSPACE" />
        </grid>
        <separator name="section_sep" h-align="stretch" v-align="stretch" />
        <stack name="actions" orientation="horizontal" spacing="6" h-align="stretch" v-align="top">
          <space name="flex_left" h-align="stretch" v-align="top" />
          <button name="ok" h-align="left" v-align="top" text="Post" flags="BUTTON_DEFAULT" />
          <button name="cancel" h-align="left" v-align="top" text="Cancel" flags="0" />
          <space name="flex_right" h-align="stretch" v-align="top" />
        </stack>
      </form>

      <form name="new_comment"
            title="New Comment"
            frame="0 0 260 84"
            flags="0"
            auto_layout="1"
            padding="8"
>
        <stack name="author_row" orientation="horizontal" spacing="6">
          <label name="lbl_author" h-align="start" text="Author:" />
          <textedit name="author" h-align="stretch" text="" />
        </stack>

        <stack name="text_row" orientation="horizontal" spacing="6">
          <label name="lbl_text" h-align="start" text="Text:" />
          <textedit name="text" h-align="stretch" text="" />
        </stack>

        <stack name="actions" orientation="horizontal" spacing="6" h-align="stretch">
          <button name="ok" h-align="left" text="Submit" flags="BUTTON_DEFAULT" />
          <space name="flex" h-align="stretch" />
          <button name="cancel" h-align="left" text="Cancel" flags="0" />
        </stack>
      </form>

      <form name="post_detail"
            title="Post Detail"
            frame="0 0 520 336"
            flags="0"
            auto_layout="1"
            padding="8"
>
        <stack name="layout" orientation="vertical" spacing="8" flags="WINDOW_FLEXSPACE" h-align="stretch" v-align="stretch">
          <stack name="header" orientation="vertical" spacing="2">
            <!-- Post header labels (populated in evCreate) -->
            <label name="lbl_title" h-align="start" font="system" color="text-normal" text="" />
            <label name="lbl_body" h-align="start" font="small" color="text-normal" text="" />
            <stack name="meta" orientation="horizontal" spacing="8">
              <label name="lbl_author" h-align="start" font="small" color="text-disabled" text="" />
              <label name="lbl_likes" h-align="start" font="small" color="text-disabled" text="" />
              <label name="lbl_cmt_hdr" h-align="start" font="small" color="text-disabled" text="" />
            </stack>
          </stack>

          <!-- Comments reportview -->
          <reportview name="comments" text="" flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_VSCROLL | WINDOW_FLEXSPACE" />

          <stack name="actions" orientation="horizontal" spacing="4">
            <button name="like_post" h-align="left" text="Like Post" flags="0" />
            <button name="add_comment" h-align="left" text="Add Comment" flags="0" />
            <button name="add_reply" h-align="left" text="Add Reply" flags="0" />
            <button name="like_comment" h-align="left" text="Like Comment" flags="0" />
            <space name="flex" h-align="stretch" />
            <button name="close" h-align="left" text="Close" flags="BUTTON_DEFAULT" />
          </stack>
        </stack>
      </form>
    </forms>
</orion>
