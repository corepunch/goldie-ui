<?xml version="1.0" encoding="UTF-8"?>
<orion
    version="1"
    name="socialfeed"
    title="Social Feed Dialogs"
    root="examples/socialfeed">

    <menus var="kMenus" count="kNumMenus">
      <menu name="file" label="File">
        <item name="quit" label="Quit" />
      </menu>

      <menu name="post" label="Post">
        <item name="new" label="New Post..." />
        <item name="like" label="Like Post" />
        <item name="view" label="View Post..." />
        <separator />
        <item name="delete" label="Delete Post" />
      </menu>

      <menu name="view" label="View">
        <item name="refresh" label="Refresh" />
      </menu>

      <menu name="help" label="Help">
        <item name="about" label="About..." />
      </menu>
    </menus>

    <toolbars>
      <toolbar name="feed">
        <button name="new" menu="post" icon="sysicon_add" text="New Post" />
        <button name="like" menu="post" icon="sysicon_heart" text="Like" />
        <button name="view" menu="post" icon="sysicon_comment" text="View Post" />
        <spacer />
        <button name="delete" menu="post" icon="sysicon_delete" text="Delete" />
      </toolbar>
    </toolbars>

    <databases>
      <!-- NeXTSTEP-style split: one database per model/table. -->
      <database name="db" class="SimpleXMLDatabase" source="socialfeed_seed.xml">
        <!-- Core entities -->
        <table name="authors" model="author">
          <field name="id" type="integer" key="YES"/>
          <field name="name" type="string"/>
          <field name="avatar" type="string"/>
        </table>

        <table name="posts" model="post">
          <field name="id" type="integer" key="YES"/>
          <field name="author_id" type="integer" relation="authors.id"/>
          <field name="title" type="string"/>
          <field name="body" type="string"/>
          <field name="like_count" type="integer"/>
          <field name="comment_count" type="integer"/>
        </table>
        
        <table name="comments" model="comment">
          <field name="id" type="integer" key="YES"/>
          <field name="post_id" type="integer" relation="posts.id"/>
          <field name="author_id" type="integer" relation="authors.id"/>
          <field name="text" type="string"/>
          <field name="like_count" type="integer"/>
        </table>
      </database>
    </databases>

    <forms>
      <form name="main_window"
            title="Social Feed"
            width="472" height="336"
            flags="WINDOW_TOOLBAR | WINDOW_STATUSBAR"
            spacing="0"
            padding="0">
        <stack name="content" spacing="0" flags="WINDOW_FLEXSPACE">
          <db-tableview name="feed"
                        database="posts"
                        action="fetch_feed"
                        flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_VSCROLL | WINDOW_FLEXSPACE">
            <column field="title" title="Title" width="0" />
            <column field="author.name" title="Author" width="80" />
            <column field="like_count" title="Likes" width="50" />
            <column field="comment_count" title="Comments" width="55" />
          </db-tableview>
        </stack>
      </form>

      <form name="new_post"
            title="New Post"
            width="272" height="250"
            spacing="0"
            padding="8">
        <grid name="fields" spacing="4">
          <column name="labels" width="56">
            <label name="lbl_author" text="Author:" />
            <label name="lbl_title" text="Title:" />
            <label name="lbl_body" text="Body:" />
          </column>
          <column name="inputs">
            <combobox name="author" 
                      bind="posts.author_id"
                      source="authors"
                      display="name"
                      value="id" />
            <textedit name="title" bind="posts.title" />
            <multiedit name="body" bind="posts.body" />
          </column>
        </grid>
        <separator name="section_sep" />
        <stack name="actions" orientation="horizontal" spacing="6">
          <space name="flex_left" />
          <button name="ok" text="Post" action="posts.insert" flags="BUTTON_DEFAULT" />
          <button name="cancel" text="Cancel" />
          <space name="flex_right" />
        </stack>
      </form>

      <form name="new_comment"
            title="New Comment"
            width="260"
            padding="8">
        <stack name="author_row" orientation="horizontal" spacing="6">
          <label name="lbl_author" text="Author:" />
          <combobox name="author"
                    bind="comments.author_id"
                    source="authors"
                    display="name"
                    value="id" />
        </stack>

        <stack name="text_row" orientation="horizontal" spacing="6">
          <label name="lbl_text" text="Text:" />
          <textedit name="text" bind="comments.text" />
        </stack>

        <separator name="sep" />
        <stack name="actions" orientation="horizontal" spacing="6">
          <button name="ok" text="Submit" action="comments.insert" flags="BUTTON_DEFAULT" />
          <space name="flex" />
          <button name="cancel" text="Cancel" />
        </stack>
      </form>

      <form name="post_detail"
            title="Post Detail"
            width="520" height="336"
            padding="8">
        <stack name="header" orientation="vertical" spacing="2">
          <!-- Post header labels (populated in evCreate) -->
          <label name="lbl_title" font="system" color="text-normal" />
          <label name="lbl_body" font="small" color="text-normal" />
          <stack name="meta" orientation="horizontal" spacing="8">
            <label name="lbl_author" font="small" color="text-disabled" />
            <label name="lbl_likes" font="small" color="text-disabled" />
            <label name="lbl_cmt_hdr" font="small" color="text-disabled" />
          </stack>
        </stack>

        <!-- Bound tableview for comments (reportview-compatible class). -->
        <db-tableview name="comments"
                      database="comments"
                      action="fetch_comments"
                      master="posts"
                      master-key="post_id"
                      flags="WINDOW_NOTITLE | WINDOW_NOFILL | WINDOW_VSCROLL | WINDOW_FLEXSPACE">
          <column field="author.name" title="Author" width="70" />
          <column field="text" title="Text" width="0" />
          <column field="like_count" title="Likes" width="45" />
        </db-tableview>

        <separator name="section_sep" />

        <stack name="actions" orientation="horizontal" spacing="4">
          <button name="like_post" text="Like Post" />
          <button name="add_comment" text="Add Comment" />
          <button name="add_reply" text="Add Reply" />
          <button name="like_comment" text="Like Comment" />
          <space name="flex" />
          <button name="close" text="Close" flags="BUTTON_DEFAULT" />
        </stack>
      </form>
    </forms>
</orion>
